# Copy this file to ".env" and adjust. ".env" is git-ignored - never commit it.
# Every variable is optional; the defaults shown here are used when unset.

# --- Data source (Open-Meteo forecast API, no key required) ---
AUTOBRIEF_API_URL=https://api.open-meteo.com/v1/forecast
AUTOBRIEF_LOCATION=London
AUTOBRIEF_LATITUDE=51.5072
AUTOBRIEF_LONGITUDE=-0.1276
AUTOBRIEF_TIMEZONE=auto
AUTOBRIEF_FORECAST_DAYS=7

# Optional key, only needed for Open-Meteo's commercial plan. Leave empty otherwise.
AUTOBRIEF_API_KEY=

# --- HTTP behaviour ---
AUTOBRIEF_TIMEOUT=10
AUTOBRIEF_MAX_RETRIES=2

# --- Output locations ---
AUTOBRIEF_REPORTS_DIR=reports
AUTOBRIEF_LOGS_DIR=logs
# AUTOBRIEF_STATE_FILE=logs/state.json

# --- Logging: DEBUG, INFO, WARNING, ERROR ---
AUTOBRIEF_LOG_LEVEL=INFO
